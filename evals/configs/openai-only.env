# Every LLM component on gpt-5.4-mini (embeddings stay local, so Ollama must still run).
# The judge shares the model with the system under test in this config.
PLANNER_PROVIDER=openai
PLANNER_MODEL=gpt-5.4-mini
PLANNER_FALLBACK_PROVIDER=openai
PLANNER_FALLBACK_MODEL=gpt-5.4-mini
CHAT_PROVIDER=openai
CHAT_MODEL=gpt-5.4-mini
RAG_PROVIDER=openai
RAG_MODEL=gpt-5.4-mini
REVIEWS_PROVIDER=openai
REVIEWS_MODEL=gpt-5.4-mini
SYNTHESIS_PROVIDER=openai
SYNTHESIS_MODEL=gpt-5.4-mini
JUDGE_PROVIDER=openai
JUDGE_MODEL=gpt-5.4-mini
