# Pre-phase-1 models: phi3 for planner + chat, gpt-4o-mini for everything else.
# Every component must be set; the runner ignores component vars from packages/server/.env.
# The judge is fixed to gpt-5.4-mini in every config so judging stays comparable.
# No *_THINK: phi3 has no thinking capability (Ollama rejects `think: true` for it; unset = not sent).
PLANNER_PROVIDER=ollama
PLANNER_MODEL=phi3:latest
PLANNER_MAX_TOKENS=512
PLANNER_FALLBACK_PROVIDER=openai
PLANNER_FALLBACK_MODEL=gpt-4o-mini
CHAT_PROVIDER=ollama
CHAT_MODEL=phi3:latest
CHAT_MAX_TOKENS=1024
RAG_PROVIDER=openai
RAG_MODEL=gpt-4o-mini
REVIEWS_PROVIDER=openai
REVIEWS_MODEL=gpt-4o-mini
SYNTHESIS_PROVIDER=openai
SYNTHESIS_MODEL=gpt-4o-mini
MATH_PROVIDER=openai
MATH_MODEL=gpt-4o-mini
JUDGE_PROVIDER=openai
JUDGE_MODEL=gpt-5.4-mini
