      {
         "id": "st-weather-paris",
         "category": "single-tool",
         "input": "What's the weather in Paris right now?",
         "expect": {
            "tools": ["getWeather"],
            "args": {
               "getWeather": {
                  "city": "paris"
               }
            },
            "answer_contains": ["paris"]
         }
      },
