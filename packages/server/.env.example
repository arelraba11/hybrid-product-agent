OPENAI_API_KEY=

# SQLite (path is relative to prisma/schema.prisma -> packages/server/prisma/chatbot.db)
DATABASE_URL="file:./chatbot.db"

OLLAMA_URL=http://127.0.0.1:11434
PORT=3000

# Embeddings are always local. Changing this requires `bun run index-kb`.
EMBEDDING_MODEL=embeddinggemma
# PRODUCT_DATA_DIR=../../data/products

# Per-call timeout for every LLM and embedding request (both providers); default 60000.
# A timed-out planner call counts as a planner failure (-> fallback planner).
# LLM_TIMEOUT_MS=60000

# Per-component LLM config: <COMPONENT>_PROVIDER (ollama | openai) and <COMPONENT>_MODEL.
# Optional per component:
#   <COMPONENT>_MAX_TOKENS        unset -> no limit on Ollama (can run away; set it for every
#                                 Ollama component), 1024 on OpenAI
#   <COMPONENT>_REASONING_EFFORT  none | minimal | low | medium | high (OpenAI reasoning models only;
#                                 anything but 'none' disables temperature; reasoning tokens count
#                                 against MAX_TOKENS). Unset -> model default.
#   <COMPONENT>_THINK             true | false (Ollama thinking models only, e.g. gemma4). Unset -> `think`
#                                 isn't sent (model default; gemma4 thinks by default, and the thinking
#                                 counts against MAX_TOKENS). Leave unset for models without thinking
#                                 (phi3): Ollama rejects `think: true` for them.
PLANNER_PROVIDER=ollama
PLANNER_MODEL=gemma4:12b
PLANNER_MAX_TOKENS=512
PLANNER_THINK=false
PLANNER_FALLBACK_PROVIDER=openai
PLANNER_FALLBACK_MODEL=gpt-5.4-mini
CHAT_PROVIDER=ollama
CHAT_MODEL=gemma4:12b
CHAT_MAX_TOKENS=1024
CHAT_THINK=false
RAG_PROVIDER=openai
RAG_MODEL=gpt-5.4-mini
REVIEWS_PROVIDER=openai
REVIEWS_MODEL=gpt-5.4-mini
SYNTHESIS_PROVIDER=openai
SYNTHESIS_MODEL=gpt-5.4-mini
MATH_PROVIDER=openai
MATH_MODEL=gpt-5.4-mini

# Legacy (pre-phase-1) models still work:
# PLANNER_MODEL=phi3:latest
# CHAT_MODEL=phi3:latest
# PLANNER_FALLBACK_MODEL=gpt-4o-mini
# RAG_MODEL=gpt-4o-mini
# REVIEWS_MODEL=gpt-4o-mini
# SYNTHESIS_MODEL=gpt-4o-mini
# MATH_MODEL=gpt-4o-mini
